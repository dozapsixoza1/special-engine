# Скопируй этот файл в .env и заполни значения

# Токен бота от @BotFather
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ

# Токен CryptoBot от @CryptoBot -> My Apps -> Create App -> API Token
